{% import '_includes/forms.twig' as forms %}

{# Which TTS backend is selected drives the whole screen. A `provider` query
   param lets the dropdown preview a mode without saving; otherwise use the saved
   value. The choice only persists once you click Save. #}
{% set provider = craft.app.request.getParam('provider') ?: (settings['apiProvider'] ?? 'elevenlabs') %}
{% if provider not in ['elevenlabs', 'bespoken'] %}
{% set provider = settings['apiProvider'] ?? 'elevenlabs' %}
{% endif %}
{% set isBespoken = provider == 'bespoken' %}

{# Define pronunciation rule sets options once to avoid duplication #}
{% set pronunciationRuleSetsOptions = settings['pronunciationRuleSets'] ?? [
    { label: 'Language 1', value: 'language1' },
    { label: 'Language 2', value: 'language2' },
    { label: 'Language 3', value: 'language3' },
    { label: 'Language 4', value: 'language4' },
    { label: 'Language 5', value: 'language5' },
    { label: 'Language 6', value: 'language6' },
    { label: 'Language 7', value: 'language7' },
    { label: 'Language 8', value: 'language8' },
    { label: 'Language 9', value: 'language9' },
    { label: 'Language 10', value: 'language10' }
] %}

{{ forms.selectField({
    label: 'TTS provider' | t('bespoken'),
    instructions: 'TTS provider instructions' | t('bespoken'),
    id: 'apiProvider',
    name: 'apiProvider',
    first: true,
    options: [
        { label: 'ElevenLabs' | t('bespoken'), value: 'elevenlabs' },
        { label: 'Bespoken TTS service (self-hosted)' | t('bespoken'), value: 'bespoken' }
    ],
    value: provider
}) }}

{# The screen reorganizes per provider on reload. Reload in the chosen mode the
   moment the dropdown changes (Craft namespaces the field, so match by name
   suffix rather than a fixed id). This is a preview reload — no save happens
   until you click Save. #}
<script>
(function () {
    var sel = document.querySelector('select[name$="[apiProvider]"], select[name="apiProvider"]');
    if (!sel) {
        return;
    }
    sel.addEventListener('change', function () {
        var url = new URL(window.location.href);
        url.searchParams.set('provider', sel.value);
        // Skip Craft's "unsaved changes" guard for this intentional reload.
        if (window.jQuery) {
            window.jQuery(window).off('beforeunload');
        }
        window.onbeforeunload = null;
        window.location.href = url.toString();
    });
})();
</script>

